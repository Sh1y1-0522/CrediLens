# HTTPS API base URL, normally ending in /v1. Do not include /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set true only for a model that accepts image_url input.
LLM_VISION=false
PORT=5173
# Optional, separate search service. Leave empty to disable; never use the model key here.
# Search sends only a hostname after individual user consent. Provider may charge.
TAVILY_API_KEY=
