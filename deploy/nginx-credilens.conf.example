# Staging-only reverse proxy. Replace example.test and certificate paths.
# Keep port 5173 closed in the cloud firewall; only Nginx should reach it.

server {
    listen 80;
    listen [::]:80;
    server_name example.test;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.test;

    ssl_certificate /etc/letsencrypt/live/example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.test/privkey.pem;

    # Staging access control. Create this file with htpasswd.
    auth_basic "CrediLens staging";
    auth_basic_user_file /etc/nginx/.htpasswd-credilens;

    client_max_body_size 5m;
    proxy_read_timeout 45s;
    proxy_send_timeout 45s;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:5173;
        proxy_set_header Origin http://127.0.0.1:5173;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
